{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_ACCESS_TOKEN": "figd_your_token_here"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
